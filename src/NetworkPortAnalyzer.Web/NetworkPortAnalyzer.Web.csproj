<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>NetworkPortAnalyzer</AssemblyName>
    <OutputType>Exe</OutputType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- JackPeek hosts Kestrel directly; no IIS hosting DLL or web.config is needed. -->
    <PublishIISAssets>false</PublishIISAssets>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/*.md;../../docs/technical-review.json;../../docs/REVIEW_MANIFEST.json;../../docs/sbom.cdx.json;../../PRIVACY.md;../../SECURITY.md;../../THIRD_PARTY_NOTICES.md" LogicalName="technical-review/%(Filename)%(Extension)" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NetworkPortAnalyzer.Tests</_Parameter1>
    </AssemblyAttribute>
    <None Include="app.ico" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\NetworkPortAnalyzer.Capture\NetworkPortAnalyzer.Capture.csproj" />
    <ProjectReference Include="..\NetworkPortAnalyzer.Windows\NetworkPortAnalyzer.Windows.csproj" />
  </ItemGroup>
</Project>
